# Copy to .env (Docker: `docker run --env-file .env ...`) and adjust.

# ---- The online service (cloud.py) ----
# The Windows app's installer: served from <data dir>/downloads/ unless this
# points somewhere else (a GitHub release, R2, ...).
# RECAPLY_DOWNLOAD_URL=https://example.com/Recaply-Setup-2.0.0.exe

# ---- The Windows app when run from source (desktop.py) ----
# The online service it signs in to. Installed builds get it from
# build\build.ps1 -CloudUrl ...
# RECAPLY_CLOUD_URL=http://127.0.0.1:8000

# Listen on all interfaces inside a container / on a server.
HOST=0.0.0.0
PORT=5000

# Accounts: the first account created becomes the admin (unlimited use).
# Session signing key: a long random string (python -c "import secrets;print(secrets.token_hex(32))").
# When empty, a random key is generated and kept in the data folder.
RECAPLY_SECRET_KEY=
# Send the session cookie over HTTPS only. Turn on once HTTPS is in front.
RECAPLY_SECURE_COOKIES=1
# More admin accounts (comma-separated emails).
# RECAPLY_ADMIN_EMAILS=you@example.com
# Public address, used for payment return links (guessed from requests when empty).
# RECAPLY_PUBLIC_URL=https://recaply.example.com

# Payments (Stripe Checkout). Without these a public server can't change plans.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_STARTER=price_...    # $9/month
# STRIPE_PRICE_PRO=price_...        # $19/month
# STRIPE_WEBHOOK_SECRET=whsec_...   # webhook: https://<site>/billing/webhook

# Where recaps and clips are worked on (mount a volume here in Docker). With a
# storage bucket below, this is only a cache: everything lives in the bucket.
RECAPLY_DATA_DIR=/data

# File storage in Cloudflare R2 (R2 > Manage API tokens > "Object Read & Write"
# for one bucket). Videos are served to browsers straight from R2; the accounts
# database is backed up there every 5 minutes and restored on a new server.
# RECAPLY_R2_ACCOUNT_ID=your-cloudflare-account-id
# RECAPLY_S3_BUCKET=recaply
# RECAPLY_S3_ACCESS_KEY=...
# RECAPLY_S3_SECRET_KEY=...
# Any other S3-compatible store: set the endpoint instead of the account id.
# RECAPLY_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# RECAPLY_S3_REGION=auto
# Videos kept on this server's disk after upload: at most this many GB, and
# only while used within this many hours.
# RECAPLY_CACHE_GB=5
# RECAPLY_CACHE_HOURS=2

# Delete recaps and their clips after this many hours (0 = keep forever).
RECAPLY_RETENTION_HOURS=72

# Analyses running at the same time; extra ones wait in a queue.
RECAPLY_MAX_ANALYSES=2

# Parallel ffmpeg decoders per analysis (default: CPU count).
# RECAPLY_SCAN_WORKERS=8

# 9:16 reels rendered at the same time (each is a full video encode).
RECAPLY_REEL_WORKERS=2

# Editor exports draw caption / animation frames in up to 4 worker processes
# (about 2x faster with captions; ~100 MB each). 0 = use threads instead.
# RECAPLY_FRAME_PROCS=1

# Largest video upload in the editor, in MB.
RECAPLY_UPLOAD_MB=2048

# Auto captions: Whisper model and device. By default the editor offers
# large-v3 (highest accuracy) and large-v3-turbo (faster); setting a model
# here forces it. Device: auto (GPU when there is one), cuda or cpu.
# RECAPLY_WHISPER_MODEL=large-v3
# RECAPLY_WHISPER_DEVICE=auto

# Bold .ttf font for reel captions and editor text (found automatically on Windows, macOS and
# in the Docker image; set it if captions say no font was found).
# RECAPLY_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Web server threads.
RECAPLY_THREADS=16

# Sites a VOD link may come from. Use * to allow anything yt-dlp supports.
RECAPLY_ALLOWED_HOSTS=youtube.com,youtu.be,twitch.tv,kick.com

# Path to a YouTube cookies.txt (mount it read-only). Keep it private.
# RECAPLY_COOKIES=/secrets/cookies.txt

# ---------- Clip finder (any video): AI providers ----------
# Transcription: faster-whisper (local, default) | groq | openai | none
# RECAPLY_TRANSCRIBER=faster-whisper
# Funnel model on an NVIDIA GPU / on the CPU (captions in the editor keep their own choice)
# RECAPLY_FUNNEL_MODEL_GPU=large-v3-turbo
# RECAPLY_FUNNEL_MODEL_CPU=small
# GROQ_API_KEY=
# RECAPLY_GROQ_MODEL=whisper-large-v3-turbo

# Scoring, titles and hooks: gemini (default, free tier) | anthropic | openai | ollama | none
# Without a key the clips are scored by rules (loudness + transcript), never failing the job.
# RECAPLY_LLM=gemini
# GEMINI_API_KEY=
# RECAPLY_GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_API_KEY=
# RECAPLY_ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=
# RECAPLY_OPENAI_MODEL=gpt-5-mini
# OLLAMA_URL=http://127.0.0.1:11434
# RECAPLY_OLLAMA_MODEL=llama3.1

# Windows sent to transcription + the LLM (the cheap-first shortlist)
# RECAPLY_SHORTLIST=0          (0 = 24 for talk, 16 for other content)
# Clips cut at the same time
# RECAPLY_CLIP_WORKERS=3
# Stage cache (audio, loudness, transcripts), keyed by video id / file content
# RECAPLY_CACHE_DIR=
# Job queue: local (threads in the app; the Windows app) | rq (Redis workers; docker compose)
# RECAPLY_QUEUE=local
# REDIS_URL=redis://localhost:6379/0
# One JSON object per log line
# RECAPLY_JSON_LOGS=0
# Estimated prices for the cost line in job summaries (USD per 1M tokens / per audio hour)
# RECAPLY_PRICE_GEMINI_IN=0.30
# RECAPLY_PRICE_GEMINI_OUT=2.50
# RECAPLY_PRICE_GROQ_HOUR=0.04

# --- Signals (Phase 3) ---
# Fetch the chat replay of Twitch / YouTube / Kick VODs (public replay data) and use chat spikes as a signal.
# RECAPLY_CHAT=1
# Read a small (<=360p) video stream of links to measure motion. Local files are always read in place.
# Turn off to save bandwidth; motion then just isn't used for links.
# RECAPLY_MOTION_LINKS=1

# --- Live mode (Phase 4) ---
# Needs streamlink (pip install streamlink) for best results; yt-dlp is the fallback.
# A link to the clip's page in webhook / Discord notifications:
# RECAPLY_PUBLIC_URL=http://127.0.0.1:5000
# Keep the recorded buffer after a stream ends (it is deleted by default):
# RECAPLY_LIVE_KEEP_BUFFER=1

# --- Editing and publishing (Phase 5) ---
# B-roll videos (free key from pexels.com/api). Without it, public-domain pictures from Openverse are used.
# RECAPLY_PEXELS_KEY=
# YouTube Shorts: a Google OAuth client of type "Desktop app" with the YouTube Data API enabled,
# then run: python -m recaply publish auth youtube
# RECAPLY_YT_CLIENT_ID=
# RECAPLY_YT_CLIENT_SECRET=
# Webhook publisher: a URL that accepts the video as a multipart POST (Zapier, Make, n8n, your own server)
# RECAPLY_PUBLISH_WEBHOOK=
# RECAPLY_PUBLISH_WEBHOOK_TOKEN=
